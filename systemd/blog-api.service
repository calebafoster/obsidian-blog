[Unit]
Description=Obsidian Blog Subscriber API
After=network.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/blog-app/obsidian-blog
EnvironmentFile=/home/orangepi/blog-app/obsidian-blog/.env
ExecStart=/home/orangepi/blog-app/obsidian-blog/.venv/bin/python api.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
